#!/usr/bin/env bash
# goal_id: EMBER-02
# workstream_id: EMBER-02A
# next_executed_outcome: EMBER-02 first sufficiently pretrained clean-genesis 3B Ember
# Local pre-commit ring: refuse a commit that violates the structural invariants.
# Install once per clone:  git config core.hooksPath .githooks   (or run tools/install-hooks.sh)
# This is the fast, local ring. It is bypassable (--no-verify); the unbypassable
# ring is the GitHub Actions required check. Both run the same kernel.

# Main-tree commit guard — operator-local policy for development tree.
# This guard blocks commits in the operator's main working tree and requires worktrees.
# No-op for clones (toplevel path will not match the development tree).
# Override for genuine need: EMBER_MAINTREE_COMMIT_OK=1 (document reason in commit body).
top=$(git rev-parse --show-toplevel 2>/dev/null)
case "$top" in
  [Bb]:/M/ember|[Bb]:\\M\\ember)
    if [ "${EMBER_MAINTREE_COMMIT_OK:-}" != "1" ]; then
      echo "BLOCKED (main-tree commit guard): the operator's main working tree is the OPERATING tree — commits happen in worktrees only. Override for genuine need: EMBER_MAINTREE_COMMIT_OK=1 with the reason in the commit body." >&2
      exit 1
    fi ;;
esac

ROOT="$(git rev-parse --show-toplevel)"
python "$ROOT/scripts/worktree_lifecycle.py" audit --strict --quiet || exit $?
exec env REPO_GUARD_SCOPE=staged bash "$ROOT/tools/repo-guard.sh"
