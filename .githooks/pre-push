#!/usr/bin/env bash
# goal_id: EMBER-01
# workstream_id: EMBER-01A
# next_executed_outcome: EMBER-02 first sufficiently pretrained clean-genesis 3B Ember
# Local pre-push ring: run the full kernel including range checks against the
# upstream so goal+evidence co-commits are caught before they leave the machine.
# Supports backup-remote exemption for private mirror (exact-match hardcoded URL only).
ROOT="$(git rev-parse --show-toplevel)"
REMOTE="${1:-origin}"
PUSH_REMOTE_URL="$(git config --get remote.$REMOTE.url 2>/dev/null || echo '')"

REMOTE_MASTER="$REMOTE/master"
if git rev-parse --verify -q "$REMOTE_MASTER" >/dev/null; then
  exec env PUSH_REMOTE_URL="$PUSH_REMOTE_URL" bash "$ROOT/tools/repo-guard.sh" --base "$REMOTE_MASTER"
else
  exec env PUSH_REMOTE_URL="$PUSH_REMOTE_URL" bash "$ROOT/tools/repo-guard.sh"
fi
