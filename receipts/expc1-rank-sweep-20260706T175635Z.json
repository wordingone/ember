      "r32": "rank-32 lifted-NS projected Muon momentum",
      "r128": "rank-128 lifted-NS projected Muon momentum (clamped to a parameter's own out_dim when out_dim < 128, reported per-param)",
      "B0_r32_int8": "rank-32 lifted-NS projected Muon momentum, with the (r x in_dim) momentum buffer STORED as symmetric per-tensor int8 + fp32 scale between steps (genuine storage dtype, not injected fp32 noise)"
    },
    "kill_criteria": {
      "eval_loss_delta_pct_le_2": "abs(arm_eval_loss_last - control_eval_loss_last) / abs(control_eval_loss_last) * 100 <= 2.0 at the end of the TIMED window -- REJECT that rank if violated",
