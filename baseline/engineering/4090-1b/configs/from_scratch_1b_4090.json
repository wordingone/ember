{
  "config_id": "from_scratch_1b_4090_v0",
  "lane": "from_scratch",
  "purpose": "Runnable engineering translation of the single-RTX-4090 >=1B theoretical ceiling for from-scratch training claims.",
  "model": {
    "family": "decoder_only_gpt",
    "parameterization": "active_trainable_dense",
    "vocab_size": 32768,
    "sequence_length": 2048,
    "n_layers": 19,
    "n_embd": 2048,
