{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ember Baseline Completion Lock",
  "type": "object",
  "required": [
    "status",
    "baseline_version",
    "generated_at_utc",
    "public_repo",
    "private_repo",
    "source_ledger",
    "line_endings",
    "claim_families",
    "governed_trials",
    "negative_results",
    "promotion",
    "anti_cheat",
    "verifier"
  ],
  "properties": {
    "status": { "type": "string", "enum": ["COMPLETE", "NOT_COMPLETE"] },
    "baseline_version": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "minLength": 1 },
    "public_repo": { "$ref": "#/$defs/repo_proof" },
    "private_repo": { "$ref": "#/$defs/repo_proof" },
    "source_ledger": {
      "type": "object",
      "required": ["path", "sha256", "source_count", "access_date_policy", "stale_source_policy"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_count": { "type": "integer", "minimum": 1 },
        "access_date_policy": { "type": "string", "minLength": 1 },
        "stale_source_policy": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "line_endings": {
      "type": "object",
      "required": ["public_receipt", "private_receipt", "public_verdict", "private_verdict"],
      "properties": {
        "public_receipt": { "type": "string", "minLength": 1 },
        "private_receipt": { "type": "string", "minLength": 1 },
        "public_verdict": { "type": "string", "enum": ["PASS"] },
        "private_verdict": { "type": "string", "enum": ["PASS"] }
      },
      "additionalProperties": true
    },
    "claim_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "OUT_OF_SCOPE_FOR_THIS_BASELINE_RELEASE"] },
          "reason": { "type": "string" },
          "receipt": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "governed_trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "trial_type", "receipt", "protocol", "comparator", "verdict", "primary_metric", "threshold", "sha256"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "trial_type": { "type": "string", "enum": ["ember_vs_external_baseline"] },
          "receipt": { "type": "string", "minLength": 1 },
          "protocol": { "type": "string", "minLength": 1 },
          "comparator": { "type": "string", "minLength": 1 },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
          "primary_metric": { "type": "string", "minLength": 1 },
          "threshold": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": true
      }
    },
    "negative_results": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": true
    },
    "promotion": {
      "type": "object",
      "required": ["public_ref_or_pr", "private_ref_or_pr", "public_manifest_sha256", "private_manifest_sha256", "parity_report"],
      "properties": {
        "public_ref_or_pr": { "type": "string", "minLength": 1 },
        "private_ref_or_pr": { "type": "string", "minLength": 1 },
        "public_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "private_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "parity_report": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "anti_cheat": {
      "type": "object",
      "required": ["not_staging_only", "not_static_only", "not_smoke_only", "not_citation_only", "governed_trial_present", "human_and_machine_status_match"],
      "properties": {
        "not_staging_only": { "type": "boolean", "const": true },
        "not_static_only": { "type": "boolean", "const": true },
        "not_smoke_only": { "type": "boolean", "const": true },
        "not_citation_only": { "type": "boolean", "const": true },
        "governed_trial_present": { "type": "boolean", "const": true },
        "human_and_machine_status_match": { "type": "boolean", "const": true }
      },
      "additionalProperties": true
    },
    "verifier": {
      "type": "object",
      "required": ["command", "script", "script_sha256", "output_receipt"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "script": { "type": "string", "minLength": 1 },
        "script_sha256": { "$ref": "#/$defs/sha256" },
        "output_receipt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "repo_proof": {
      "type": "object",
      "required": ["url", "ref", "commit", "baseline_tree_sha256"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 7 },
        "baseline_tree_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}